{{ ansible_managed | comment }}

{% if unbound_adblock %}
rpz:
    name: "unbound-adblock"
    zonefile: "/var/unbound/db/adblock.rpz"
    rpz-log: yes
    rpz-log-name: "unbound-adblock"
{% endif %}

remote-control:
    control-enable: {{ unbound_remote_control_enable }}
    control-use-cert: {{ unbound_remote_control_use_cert }}
    control-interface: {{ unbound_remote_control_interface }}

server:
    chroot: /var/unbound
    do-daemonize: yes
{% for interface in unbound_interfaces %}
    interface: {{ interface }}
{% endfor %}
    do-ip6: {{ unbound_do_ip6 }}
{% for acl in unbound_access_control %}
    access-control: {{ acl }}
{% endfor %}
    hide-identity: {{ unbound_hide_identity }}
    hide-version: {{ unbound_hide_version }}
{% if unbound_local_zone %}
    local-zone: {{ unbound_local_zone }}
{% endif %}

    module-config: "respip validator iterator"

{% for record in unbound_local_data %}
    local-data: "{{ record }}"
{% endfor %}

{% for record in unbound_local_data_ptr %}
    local-data-ptr: "{{ record }}"
{% endfor %}
